# ==========================================================================
# Parâmetros da aplicação de prospecção B2B - Seguro Garantia
# Copie este arquivo para ".env" e ajuste os valores.
# ==========================================================================

# --- Janela de busca -----------------------------------------------------
# Do dia atual até X dias atrás (licitações, contratos e aditivos).
DIAS_RETROATIVOS=30

# Semente estável: força a janela a terminar em uma data específica (DD/MM/AAAA).
# Deixe vazio para usar a data de hoje.
DATA_REFERENCIA=

# --- Filtro de garantia --------------------------------------------------
# Palavras-chave que caracterizam exigência de garantia contratual.
PALAVRAS_CHAVE_GARANTIA=seguro garantia|fiança bancária|garantia contratual|caução|cláusula de garantia|retomada|step-in|aditivo de prorrogação|termo aditivo|art. 96|art. 98|art. 102

# Quando true, mantém SOMENTE registros cujo texto contenha uma palavra-chave.
# Quando false, mantém todos e apenas sinaliza/estima a garantia.
FILTRO_GARANTIA_ESTRITO=false

# Quando true, DESCARTA registros sem exigência explícita de garantia no texto.
# Implica LER_ANEXOS_PDF=true (bem mais lento).
EXIGIR_GARANTIA_NO_TEXTO=false

# --- Valores -------------------------------------------------------------
# Valor mínimo do contrato/licitação para entrar na carteira.
VALOR_MINIMO=0

# Percentual usado para ESTIMAR a garantia quando o edital não informa.
PERCENTUAL_GARANTIA=0.05

# --- Escopo --------------------------------------------------------------
# UFs (vazio = Brasil inteiro). Ex.: SP,RJ,MG
UFS=
# Modalidades PNCP para a busca de EDITAIS (4=Concorrência Eletrônica,
# 5=Concorrência Presencial, 6=Pregão Eletrônico, 7=Pregão Presencial,
# 8=Dispensa, 9=Inexigibilidade, 12=Credenciamento).
MODALIDADES=4,5,6,7,8,9

# Buscar também editais abertos (além dos contratos adjudicados/aditados).
BUSCAR_EDITAIS=true
# Incluir editais ainda SEM vencedor (entram só com órgão e objeto).
INCLUIR_EDITAIS_SEM_VENCEDOR=true

# Filtro por ramo de atividade (obras, engenharia, limpeza, etc.).
FILTRAR_POR_RAMO=true
# RAMOS_PALAVRAS_CHAVE= (opcional; vazio usa a lista padrão)
# Filtrar pelo CNAE da empresa vencedora (aplicado após o enriquecimento de CNPJ).
FILTRAR_POR_CNAE=false
# CNAE_ALVO=41,42,43,33,38,39,71,80,81

# --- Fontes complementares ----------------------------------------------
# Consultar a API pública de contratos do Compras.gov.br (esfera federal).
# A API exige o código do órgão, então informe a lista de órgãos a varrer.
USAR_COMPRAS_GOV=false
COMPRAS_GOV_ORGAOS=

# Portais de bancos públicos / economia mista (estrutura; ver sources/bancos.py).
USAR_LICITACOES_E=false       # Banco do Brasil
USAR_CAIXA=false              # Caixa Econômica Federal
USAR_BNDES=false
USAR_PETRONECT=false          # Petrobras

# Portais estaduais / municipais (ver sources/estaduais.py).
# e-Negócios SP está IMPLEMENTADO (busca por CNPJ do vencedor).
USAR_ENEGOCIOS_SP=false
ENEGOCIOS_MAX_CNPJS=50
ENEGOCIOS_DETALHES=false
ENEGOCIOS_CNPJS=              # CNPJs extras (vírgula), sem depender do PNCP
# Demais portais: apenas estruturados (stubs) por enquanto.
USAR_BEC_SP=false
USAR_COMPRAS_RS=false
USAR_COMPRAS_PUBLICAS=false
USAR_BLL_COMPRAS=false

# --- PDF (busca da cláusula de garantia no texto do edital) --------------
# Baixa e lê o PDF do edital/contrato para procurar as palavras-chave.
# ATENÇÃO: deixa a execução bem mais lenta. Limite em LER_PDF_MAX_REGISTROS.
LER_ANEXOS_PDF=false
LER_PDF_MAX_REGISTROS=30

# --- Enriquecimento ------------------------------------------------------
ENRIQUECER_CNPJ=true
USAR_RECEITAWS=false          # fallback p/ quando a BrasilAPI falhar
ENRIQUECER_WEB=true           # busca e-mail/telefone/WhatsApp em sites e diretórios
WEB_MAX_EMPRESAS=0            # 0 = sem teto
PAUSA_WEB=5                   # segundos entre buscas web (evita bloqueio)
PAUSA_CNPJ=0.5                # segundos entre consultas de CNPJ (APIs aguentam pouco)
MAX_WORKERS=6                 # paralelismo (threads) do enriquecimento de CNPJ e web

# --- Desempenho / resiliência -------------------------------------------
PAUSA_ENTRE_REQUISICOES=3     # segundos entre páginas da API do PNCP
MAX_PAGINAS=200               # trava de segurança por consulta
TAMANHO_PAGINA=50             # registros por página
TIMEOUT=30                    # timeout de cada requisição (s)
MAX_TENTATIVAS=3              # tentativas por requisição antes de desistir

# --- Saída ---------------------------------------------------------------
DIRETORIO_SAIDA=./saida
NOME_ARQUIVO=prospeccao_seguro_garantia
GERAR_CSV=true
INCLUIR_ABA_PARAMETROS=true
